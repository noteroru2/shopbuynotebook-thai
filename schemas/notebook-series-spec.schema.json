{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ร้านรับซื้อโน๊ตบุ๊ค.com/schemas/notebook-series-spec.schema.json",
  "title": "VerifiedNotebookSeriesSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "brand",
    "series",
    "slug",
    "pageType",
    "configurationScope",
    "eligibility",
    "sources",
    "retrievedDate"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "brand": { "type": "string", "minLength": 1 },
    "series": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "pageType": { "type": "string", "const": "Series" },
    "category": {
      "type": ["string", "null"],
      "enum": ["gaming", "ultrabook", "business", "creator", "mainstream", "convertible", "handheld", "chrome", null]
    },
    "knownModelFamilies": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "verifiedGenerationRange": { "type": ["string", "null"] },
    "configurationScope": { "type": "string", "const": "SERIES" },
    "eligibility": {
      "type": "string",
      "enum": [
        "READY_HIGH_CONFIDENCE",
        "READY_FAMILY_LEVEL",
        "LIMITED_DATA",
        "AMBIGUOUS_MODEL",
        "UNVERIFIED"
      ]
    },
    "officialUrl": { "type": ["string", "null"], "format": "uri" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "sourceType", "verificationStatus"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "sourceType": {
            "type": "string",
            "enum": [
              "official_product",
              "official_spec_db",
              "official_pdf",
              "official_support",
              "repository_verified"
            ]
          },
          "title": { "type": "string" },
          "verificationStatus": {
            "type": "string",
            "enum": ["VERIFIED", "PARTIAL", "UNVERIFIED", "BROKEN_LINK"]
          }
        }
      }
    },
    "retrievedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "notes": { "type": "string" }
  }
}
