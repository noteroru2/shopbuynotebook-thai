---
import { SITE } from '../lib/seo';
import { coreAuthorityOwners, priorityAuthorityBrands } from '../lib/internal-links';

const primaryOwners = coreAuthorityOwners.filter((item) =>
  ['generic-commercial', 'valuation', 'seller-flow', 'protected-used', 'brand-hub', 'model-hub', 'condition-hub', 'location-hub', 'informational-hub'].includes(item.role),
);

const knowledgeLinks = [
  { label: 'ก่อนขายโน๊ตบุ๊คต้องล้างข้อมูลอย่างไร', href: '/blog/ก่อนขายโน๊ตบุ๊คต้องล้างข้อมูลอย่างไร/' },
  { label: 'โน๊ตบุ๊คติดรหัส Windows ขายได้ไหม', href: '/blog/โน๊ตบุ๊คติดรหัส-windows-ขายได้ไหม/' },
  { label: 'วิธีดูรุ่นโน๊ตบุ๊ค Windows ก่อนส่งประเมิน', href: '/blog/วิธีดูรุ่นโน๊ตบุ๊ค-windows-ก่อนส่งประเมินราคา/' },
];
---

<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-3">
          <span class="rounded-3xl border border-slate-200 bg-slate-950/95 p-2 shadow-sm">
            <img src="/images/logo-ranrubsue-notebook-black-280.webp" alt="โลโก้ ร้านรับซื้อโน๊ตบุ๊ค.com" width="280" height="140" class="h-12 w-auto flex-none object-contain" loading="lazy" decoding="async" />
          </span>
          <p class="text-lg font-semibold text-slate-900">ร้านรับซื้อโน๊ตบุ๊ค.com</p>
        </div>
        <p class="mt-3 text-sm leading-6 text-slate-600">รับประเมินโน๊ตบุ๊คมือสองจากรุ่น สเปก สภาพ แบตเตอรี่ อาการ และอุปกรณ์ ราคาสุดท้ายยืนยันหลังตรวจเครื่องจริง</p>
        <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-sm font-semibold text-slate-900">หน้าร้านจริง</p>
          <p class="mt-1 text-sm text-slate-600">{SITE.physicalStoreName}</p>
          <a class="mt-2 inline-flex text-sm font-semibold text-emerald-700 underline underline-offset-4" href={SITE.googleMapsUrl} target="_blank" rel="noopener noreferrer">เปิดใน Google Maps</a>
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          <a class="rounded-xl bg-[#06C755] px-4 py-2 text-sm font-semibold text-white" href={SITE.lineUrl} target="_blank" rel="noopener noreferrer">LINE {SITE.lineHandle}</a>
          <a class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-900" href={`tel:${SITE.telephone}`}>โทร {SITE.telephone}</a>
        </div>
      </div>

      <div>
        <p class="text-sm font-semibold text-slate-900">หน้าหลักสำหรับขายและประเมิน</p>
        <ul class="mt-3 space-y-2 text-sm">
          {primaryOwners.map((item) => (
            <li><a class="text-slate-600 hover:text-emerald-700" href={item.href}>{item.label}</a></li>
          ))}
          <li><a class="font-semibold text-slate-700 hover:text-emerald-700" href="/รับเหมาโน๊ตบุ๊ค/">ขายโน๊ตบุ๊คหลายเครื่อง / องค์กร</a></li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold text-slate-900">เลือกตามแบรนด์</p>
        <ul class="mt-3 grid grid-cols-2 gap-x-3 gap-y-2 text-sm lg:grid-cols-1">
          {priorityAuthorityBrands.map((brand) => (
            <li><a class="text-slate-600 hover:text-emerald-700" href={brand.href}>{brand.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold text-slate-900">ความรู้ก่อนขาย</p>
        <ul class="mt-3 space-y-2 text-sm">
          {knowledgeLinks.map((item) => (
            <li><a class="text-slate-600 hover:text-emerald-700" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
        <p class="mt-6 text-sm font-semibold text-slate-900">ข้อมูลและช่องทาง</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-slate-600 hover:text-slate-900" href="/คำถามที่พบบ่อย/">คำถามที่พบบ่อย</a></li>
          <li><a class="text-slate-600 hover:text-slate-900" href="/ขั้นตอนและเงื่อนไขการให้บริการ/">ขั้นตอนและเงื่อนไข</a></li>
          <li><a class="text-slate-600 hover:text-slate-900" href="/นโยบายความเป็นส่วนตัว/">นโยบายความเป็นส่วนตัว</a></li>
          <li><a class="text-slate-600 hover:text-slate-900" href={SITE.sameAs.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>
          <li><a class="text-slate-600 hover:text-slate-900" href={SITE.sameAs.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-200 pt-6 text-xs leading-6 text-slate-500">
      <p>2026 ร้านรับซื้อโน๊ตบุ๊ค.com โดย {SITE.companyLegalName}</p>
      <p class="mt-1">{SITE.companyRegisteredAddress}</p>
      <p class="mt-3">หน้าร้านจริงอยู่อุบลราชธานี พื้นที่อื่นควรส่งข้อมูลและยืนยันวิธีนัดหรือจัดส่งก่อน</p>
    </div>
  </div>
</footer>
