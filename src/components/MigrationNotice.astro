---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  targetHref: string;
  targetLabel: string;
  note?: string;
}

const {
  eyebrow = 'Notebook V2 — Consolidated Intent',
  title,
  description,
  targetHref,
  targetLabel,
  note = 'หน้านี้ถูกลดบทบาทในสถาปัตยกรรม V2 เพื่อไม่ให้หลาย URL แข่งขันกันด้วยคำค้นเดียวกัน',
} = Astro.props;
---

<section class="mx-auto w-full max-w-4xl px-4 py-16 sm:py-24">
  <div class="rounded-3xl border border-amber-200 bg-amber-50/70 p-6 shadow-sm sm:p-10">
    <p class="text-sm font-extrabold uppercase tracking-wide text-amber-700">{eyebrow}</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl">{title}</h1>
    <p class="mt-5 text-base leading-8 text-slate-700">{description}</p>
    <p class="mt-4 text-sm leading-7 text-slate-600">{note}</p>
    <a
      href={targetHref}
      class="mt-8 inline-flex items-center justify-center rounded-2xl bg-slate-950 px-5 py-3 text-sm font-extrabold text-white shadow-sm transition hover:bg-slate-800"
    >
      {targetLabel} →
    </a>
  </div>
</section>
