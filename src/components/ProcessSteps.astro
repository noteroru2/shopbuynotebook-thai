---
interface Props {
  title?: string;
}

const { title = 'ขายโน๊ตบุ๊คกับเรา ง่ายใน 4 ขั้นตอน' } = Astro.props;

const steps = [
  { title: 'ส่งรูปและข้อมูลเครื่อง', desc: 'แจ้งรุ่น สเปก สภาพ อาการ อุปกรณ์ และจังหวัดที่สะดวกส่งมอบ' },
  { title: 'รับราคาประเมินเบื้องต้น', desc: 'ทีมงานประเมินจากข้อมูลที่ได้รับโดยไม่มีข้อผูกมัดว่าต้องขาย' },
  { title: 'ยืนยันวิธีนัดหรือจัดส่ง', desc: 'ตรวจสอบพื้นที่ ตารางงาน และเงื่อนไขก่อนนัดหรือส่งเครื่องทุกครั้ง' },
  { title: 'ตรวจเครื่อง ตกลงราคา และชำระเงิน', desc: 'ยืนยันราคาสุดท้ายหลังตรวจเครื่องจริง และชำระเมื่อผู้ขายตกลง' },
];
---

<section class="mx-auto w-full max-w-6xl px-4 pt-12" data-home-process aria-labelledby="home-process-heading">
  <div class="rounded-3xl border border-slate-200 bg-white/70 p-6 shadow-sm backdrop-blur sm:p-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
      <div class="lg:max-w-xl">
        <h2 id="home-process-heading" class="text-xl font-bold text-slate-900">{title}</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          เริ่มจากข้อมูลเครื่อง จากนั้นยืนยันวิธีส่งมอบและราคาสุดท้ายตามลำดับ
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {steps.map((s, idx) => (
            <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm" data-home-process-card>
              <p class="text-xs font-semibold text-slate-500">ขั้นตอน {idx + 1}</p>
              <p class="mt-2 text-sm font-semibold text-slate-900">{s.title}</p>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <figure class="lg:w-[520px]">
        <picture>
          <source srcset="/images/rubsue-notebook-process-steps.webp" media="(min-width: 1024px)" />
          <img
            src="/images/rubsue-notebook-process-steps-800.webp"
            alt="ขั้นตอนการขายโน๊ตบุ๊ค 4 ขั้นตอน ตั้งแต่ถ่ายรูป แชท LINE ตรวจสภาพ และรับเงิน"
            loading="lazy"
            decoding="async"
            class="w-full rounded-3xl border border-slate-200 object-cover shadow-sm"
            width="800"
            height="450"
          />
        </picture>
        <figcaption class="mt-3 text-xs text-slate-500">
          ภาพประกอบขั้นตอนการส่งรูป ประเมินราคา นัดรับเครื่อง และรับเงิน
        </figcaption>
      </figure>
    </div>
  </div>
</section>

