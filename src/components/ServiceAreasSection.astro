---
const locations = [
  { label: 'กรุงเทพ', href: '/รับซื้อโน๊ตบุ๊ค/กรุงเทพ' },
  { label: 'นนทบุรี', href: '/รับซื้อโน๊ตบุ๊ค/นนทบุรี' },
  { label: 'ปทุมธานี', href: '/รับซื้อโน๊ตบุ๊ค/ปทุมธานี' },
  { label: 'ขอนแก่น', href: '/รับซื้อโน๊ตบุ๊ค/ขอนแก่น' },
  { label: 'อุบลราชธานี', href: '/รับซื้อโน๊ตบุ๊ค/อุบลราชธานี' },
  { label: 'ภาคอีสาน', href: '/รับซื้อโน๊ตบุ๊ค/ภาคอีสาน' },
];
---

<section class="mx-auto w-full max-w-6xl px-4 pt-12">
  <div class="rounded-3xl border border-slate-200 bg-gradient-to-br from-sky-50 via-white to-emerald-50 p-6 shadow-sm sm:p-8">
    <h2 class="text-xl font-extrabold text-slate-900">
      วิธีใช้บริการรับซื้อโน๊ตบุ๊คตามพื้นที่
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-slate-700">
      หน้าร้านจริงอยู่จังหวัดอุบลราชธานี ลูกค้าจังหวัดอื่นส่งรูปและข้อมูลเพื่อประเมินเบื้องต้นก่อน แล้วสอบถามวิธีนัดหรือจัดส่งตามพื้นที่ ตารางงาน และเงื่อนไขที่ทีมงานยืนยัน ดูรายละเอียดที่หน้า{' '}
      <a class="underline underline-offset-4" href="/พื้นที่ให้บริการ/">พื้นที่ให้บริการ</a>
    </p>
    <p class="mt-3 text-sm leading-relaxed text-slate-700">
      การนัดรับไม่ใช่บริการที่ยืนยันได้ทุกพื้นที่ โปรดสอบถามรอบก่อนนัดหมายทุกครั้ง หากไม่สะดวกนัด สามารถสอบถามขั้นตอนจัดส่งเครื่องมาตรวจได้
    </p>
    <p class="mt-3 text-sm leading-relaxed text-slate-700">
      ราคาจากรูปเป็นเพียงราคาเบื้องต้น ราคาสุดท้ายยืนยันหลังตรวจเครื่องจริงและตกลงซื้อขาย
      ดูหน้ารายพื้นที่ได้ที่{' '}
      <a class="font-semibold text-emerald-700 underline underline-offset-4 hover:text-emerald-800" href="/รับซื้อโน๊ตบุ๊ค/ภาคอีสาน/">รับซื้อโน๊ตบุ๊คภาคอีสาน</a>
      {' '}และหน้า <a class="underline underline-offset-4" href="/พื้นที่ให้บริการ/">พื้นที่ให้บริการ</a>
    </p>

    <div class="mt-5 flex flex-wrap gap-2">
      {locations.map((l) => (
        <a
          href={l.href}
          class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-800 shadow-sm hover:bg-emerald-50 hover:border-emerald-200"
        >
          {l.label}
        </a>
      ))}
    </div>

    <p class="mt-4 text-xs text-slate-500">
      หมายเหตุ: หน้าพื้นที่เป็นข้อมูลการให้บริการตามการนัดหมายหรือการจัดส่ง ไม่ใช่ที่ตั้งสาขา{' '}
      <a class="underline underline-offset-4" href="/พื้นที่ให้บริการ/">ดูพื้นที่ให้บริการทั้งหมด</a>
    </p>
  </div>
</section>

