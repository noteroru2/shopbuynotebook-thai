---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButtons from '../../components/CTAButtons.astro';
import FAQ from '../../components/FAQ.astro';
import { absoluteUrl, breadcrumbListSchema, faqPageSchema } from '../../lib/seo';

const canonical = absoluteUrl('/ประเมินราคา/');
const title = 'ประเมินราคาโน๊ตบุ๊ค เช็คราคาและตีราคาก่อนขาย | ร้านรับซื้อโน๊ตบุ๊ค.com';
const description = 'ประเมินราคาโน๊ตบุ๊คก่อนขาย ส่งรุ่น สเปก รูปสภาพ แบตเตอรี่ อาการและอุปกรณ์เพื่อรับกรอบราคาเบื้องต้น ราคาสุดท้ายยืนยันหลังตรวจเครื่องจริง';

const faqs = [
  {
    question: 'ประเมินราคาจากรูปได้เลยไหม?',
    answer: 'ประเมินเบื้องต้นได้ครับ หากมีรุ่น สเปก รูปสภาพและอาการครบ แต่ราคาสุดท้ายต้องยืนยันหลังตรวจเครื่องจริง',
  },
  {
    question: 'เช็คราคา ตีราคา และประเมินราคา ต่างกันไหม?',
    answer: 'ในเว็บไซต์ V2 ใช้หน้าเดียวกันครับ ทั้งสามคำหมายถึงการขอกรอบมูลค่าก่อนตัดสินใจขาย จึงรวมไว้เพื่อให้ข้อมูลและ Search Intent ชัดเจน',
  },
  {
    question: 'ข้อมูลอะไรมีผลต่อกรอบราคามากที่สุด?',
    answer: 'รุ่นย่อยและสเปกจริงเป็นฐาน จากนั้นดูสภาพจอ บอดี้ แบตเตอรี่ อาการ พอร์ต อุปกรณ์ และความต้องการของตลาดในช่วงนั้น',
  },
  {
    question: 'ได้กรอบราคาแล้วจำเป็นต้องขายไหม?',
    answer: 'ไม่จำเป็นครับ กรอบราคาเบื้องต้นใช้ประกอบการตัดสินใจได้ ราคาสุดท้ายยืนยันเมื่อมีการตรวจเครื่องจริงและทั้งสองฝ่ายตกลงกัน',
  },
];

const schemas = [
  breadcrumbListSchema([
    { name: 'หน้าแรก', url: absoluteUrl('/') },
    { name: 'ประเมินราคาโน๊ตบุ๊ค', url: canonical },
  ]),
  faqPageSchema(faqs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex={true}
  schemas={schemas}
>
  <section class="relative overflow-hidden bg-slate-950 py-16 text-white sm:py-24">
    <div class="absolute inset-0 bg-gradient-to-br from-emerald-900/45 via-slate-950 to-sky-950/50"></div>
    <div class="relative mx-auto w-full max-w-6xl px-4">
      <p class="text-sm font-extrabold uppercase tracking-[0.18em] text-emerald-300">Valuation Owner — V2</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-extrabold tracking-tight sm:text-6xl">
        ประเมินราคาโน๊ตบุ๊คก่อนขาย
        <span class="mt-2 block text-emerald-300">เช็คราคาและตีราคาในหน้าเดียว</span>
      </h1>
      <p class="mt-6 max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">
        ส่งรุ่น สเปก รูปสภาพ อาการ แบตเตอรี่ และอุปกรณ์ที่มี เพื่อให้ร้านประเมินกรอบราคาเบื้องต้นจากข้อมูลเครื่องจริง
        ราคาสุดท้ายยืนยันหลังตรวจเครื่อง ไม่ใช้ชื่อรุ่นอย่างเดียวในการฟันราคา
      </p>
      <div class="mt-8">
        <CTAButtons primaryText="ส่งรูปและสเปกเพื่อประเมิน" secondaryText="โทรสอบถามขั้นตอน" />
      </div>
    </div>
  </section>

  <main class="mx-auto w-full max-w-6xl px-4 py-14 sm:py-20">
    <section aria-labelledby="valuation-inputs-heading">
      <p class="text-sm font-extrabold text-emerald-700">ข้อมูลที่ควรส่ง</p>
      <h2 id="valuation-inputs-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950">
        4 กลุ่มข้อมูลที่ช่วยให้กรอบราคาใกล้เครื่องจริงขึ้น
      </h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['1. รุ่นและรหัสเครื่อง', 'ถ่ายป้ายรุ่นหรือหน้าข้อมูลระบบให้เห็นชื่อรุ่นย่อย ไม่ใช้ชื่อซีรีส์กว้าง ๆ อย่างเดียว'],
          ['2. CPU / GPU / RAM / SSD', 'แจ้งสเปกจริง โดยเฉพาะการ์ดจอและความจุที่ทำให้รุ่นเดียวกันมีมูลค่าต่างกัน'],
          ['3. สภาพและอาการ', 'รูปจอ คีย์บอร์ด ฝาบน ก้นเครื่อง มุมเครื่อง พร้อมแจ้งจอแตก เปิดไม่ติด บานพับหรือพอร์ตมีปัญหา'],
          ['4. แบตและอุปกรณ์', 'แจ้ง Battery Health หรืออาการแบต พร้อมที่ชาร์จ กล่อง ใบเสร็จ หรือของที่ขาด'],
        ].map(([heading, body]) => (
          <article class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="font-extrabold text-slate-950">{heading}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-16 grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-start" aria-labelledby="valuation-method-heading">
      <div>
        <p class="text-sm font-extrabold text-sky-700">วิธีประเมิน</p>
        <h2 id="valuation-method-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950">ร้านดูอะไรตอนตีราคา</h2>
        <ol class="mt-6 space-y-4 text-sm leading-7 text-slate-700">
          <li><strong>ยืนยันรุ่นและสเปกก่อน</strong> — รุ่นย่อย CPU GPU RAM SSD และปีโดยประมาณเป็นฐานของกรอบราคา</li>
          <li><strong>ปรับตามสภาพจริง</strong> — จอ บอดี้ แบต พอร์ต บานพับ คีย์บอร์ด และอาการที่แจ้งมีผลต่างกันตามประเภทเครื่อง</li>
          <li><strong>ดูความครบของอุปกรณ์</strong> — ที่ชาร์จ กล่อง ใบเสร็จ หรืออุปกรณ์ที่ขาดมีผลต่อความพร้อมนำไปขายต่อ</li>
          <li><strong>ยืนยันหลังตรวจเครื่อง</strong> — ราคาจากรูปเป็นกรอบเบื้องต้น ราคาสุดท้ายต้องอิงเครื่องจริงและข้อตกลง ณ วันตรวจรับ</li>
        </ol>
      </div>
      <aside class="rounded-3xl border border-emerald-200 bg-emerald-50 p-6">
        <h3 class="text-xl font-extrabold text-slate-950">ราคาประเมินเบื้องต้น ≠ ราคาสุดท้าย</h3>
        <p class="mt-3 text-sm leading-7 text-slate-700">
          รูปและข้อมูลช่วยให้ตั้งกรอบก่อนตัดสินใจ แต่ยังมองไม่เห็นทุกจุด เช่น พอร์ตที่เสียเป็นครั้งคราว จอมีเส้นเมื่อใช้งานนาน หรือแบตบวมด้านใน
          จึงต้องยืนยันอีกครั้งหลังตรวจเครื่องจริง
        </p>
      </aside>
    </section>

    <section class="mt-16" aria-labelledby="valuation-types-heading">
      <h2 id="valuation-types-heading" class="text-3xl font-extrabold tracking-tight text-slate-950">ปัจจัยต่างกันตามประเภทเครื่อง</h2>
      <div class="mt-7 grid gap-4 md:grid-cols-2">
        <a href="/แบรนด์/macbook/" class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-emerald-300">
          <h3 class="font-extrabold text-slate-950">MacBook</h3>
          <p class="mt-2 text-sm leading-7 text-slate-600">ดูชิป รุ่นย่อย RAM/SSD สุขภาพแบต Cycle Count จอ บอดี้ ที่ชาร์จ และสถานะบัญชี Apple</p>
        </a>
        <a href="/รุ่น/" class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-emerald-300">
          <h3 class="font-extrabold text-slate-950">Gaming / รุ่นสเปกสูง</h3>
          <p class="mt-2 text-sm leading-7 text-slate-600">GPU รุ่นย่อย ระบบระบายความร้อน พัดลม จอ ที่ชาร์จกำลังสูง และร่องรอยการใช้งานหนักมีน้ำหนักมาก</p>
        </a>
        <a href="/รับซื้อโน๊ตบุ๊คมือสอง/" class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-emerald-300">
          <h3 class="font-extrabold text-slate-950">เครื่องใช้งานแล้ว</h3>
          <p class="mt-2 text-sm leading-7 text-slate-600">อายุการใช้งาน รอย สภาพแบต อุปกรณ์ และความสมบูรณ์ของตัวเครื่องช่วยอธิบายความต่างระหว่างเครื่องรุ่นเดียวกัน</p>
        </a>
        <a href="/อาการ/" class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-emerald-300">
          <h3 class="font-extrabold text-slate-950">เครื่องมีอาการ</h3>
          <p class="mt-2 text-sm leading-7 text-slate-600">เปิดไม่ติด จอแตก แบตเสื่อม โดนน้ำ หรืออาการอื่นต้องแยกต้นทุนและความเสี่ยงจากเครื่องสภาพปกติ</p>
        </a>
      </div>
    </section>

    <section class="mt-16 rounded-3xl bg-slate-950 p-7 text-white sm:p-10" aria-labelledby="valuation-flow-heading">
      <h2 id="valuation-flow-heading" class="text-3xl font-extrabold">จากขอราคา → ถึงตัดสินใจขาย</h2>
      <div class="mt-7 grid gap-4 md:grid-cols-4">
        {[
          ['1', 'ส่งข้อมูล', 'รุ่น สเปก รูปสภาพ อาการ และอุปกรณ์'],
          ['2', 'รับกรอบเบื้องต้น', 'ร้านประเมินจากข้อมูลที่ส่งและอาจถามรายละเอียดเพิ่ม'],
          ['3', 'ตัดสินใจ', 'เปรียบเทียบหรือคิดต่อได้ ยังไม่จำเป็นต้องตกลงขาย'],
          ['4', 'ตรวจและยืนยัน', 'เมื่อตกลงส่งเครื่องจึงตรวจจริงและยืนยันราคาสุดท้าย'],
        ].map(([n, heading, body]) => (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
            <span class="text-sm font-extrabold text-emerald-300">{n}</span>
            <h3 class="mt-2 font-extrabold">{heading}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-300">{body}</p>
          </div>
        ))}
      </div>
      <div class="mt-8">
        <CTAButtons primaryText="ส่งข้อมูลเพื่อประเมินเบื้องต้น" secondaryText="โทรสอบถาม" />
      </div>
    </section>

    <section class="mt-16" aria-labelledby="valuation-next-heading">
      <h2 id="valuation-next-heading" class="text-2xl font-extrabold text-slate-950">หน้าที่เกี่ยวข้อง</h2>
      <div class="mt-5 flex flex-wrap gap-3 text-sm font-bold">
        <a class="rounded-full bg-slate-100 px-4 py-2 text-slate-800" href="/">รับซื้อโน๊ตบุ๊ค</a>
        <a class="rounded-full bg-slate-100 px-4 py-2 text-slate-800" href="/ขายโน๊ตบุ๊ค/">ขายโน๊ตบุ๊ค</a>
        <a class="rounded-full bg-slate-100 px-4 py-2 text-slate-800" href="/รับซื้อโน๊ตบุ๊คมือสอง/">รับซื้อโน๊ตบุ๊คมือสอง</a>
        <a class="rounded-full bg-slate-100 px-4 py-2 text-slate-800" href="/แบรนด์/">ดูตามแบรนด์</a>
        <a class="rounded-full bg-slate-100 px-4 py-2 text-slate-800" href="/อาการ/">ดูตามอาการ</a>
      </div>
    </section>
  </main>

  <FAQ title="คำถามเรื่องประเมินราคาโน๊ตบุ๊ค" faqs={faqs} />
</BaseLayout>
