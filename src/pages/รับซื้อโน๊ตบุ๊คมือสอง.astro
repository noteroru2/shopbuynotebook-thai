---
import BaseLayout from '../layouts/BaseLayout.astro';
import MigrationNotice from '../components/MigrationNotice.astro';
import { absoluteUrl } from '../lib/seo';

const target = '/';
---

<BaseLayout
  title="รับซื้อโน๊ตบุ๊คมือสอง | ย้ายรวมหน้ารับซื้อโน๊ตบุ๊คหลัก"
  description="หน้ารับซื้อโน๊ตบุ๊คมือสองถูกรวมเข้าหน้าหลัก เพื่อรวมสัญญาณคำค้นรับซื้อโน๊ตบุ๊คและรับซื้อโน๊ตบุ๊คมือสองไว้ที่เจ้าของหน้าเดียว"
  canonical={absoluteUrl(target)}
  noindex={true}
>
  <MigrationNotice
    title="รับซื้อโน๊ตบุ๊คมือสอง ย้ายรวมเข้าหน้าหลัก"
    description="ข้อมูลการประเมินโน๊ตบุ๊คมือสองถูกรวมไว้ที่หน้ารับซื้อโน๊ตบุ๊คหลัก เพื่อให้ผู้ใช้และ Search Engine พบข้อมูลจากหน้าเจ้าของเดียว ไม่แยก Money Page ที่มี intent ซ้ำกัน"
    targetHref={target}
    targetLabel="ไปหน้ารับซื้อโน๊ตบุ๊ค"
  />
</BaseLayout>
