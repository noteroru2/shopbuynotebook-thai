---
import BaseLayout from '../layouts/BaseLayout.astro';
import MigrationNotice from '../components/MigrationNotice.astro';
import { absoluteUrl } from '../lib/seo';

const target = '/ประเมินราคา/';
---

<BaseLayout
  title="เช็คราคาโน๊ตบุ๊ค | ย้ายรวมหน้าประเมินราคา"
  description="คำค้นเช็คราคาโน๊ตบุ๊คถูกรวมเข้าหน้าประเมินราคา เพื่อให้ข้อมูลกรอบราคา ปัจจัยประเมิน และขั้นตอนส่งข้อมูลอยู่ในเจ้าของหน้าเดียว"
  canonical={absoluteUrl(target)}
  noindex={true}
>
  <MigrationNotice
    title="เช็คราคาโน๊ตบุ๊ค ย้ายรวมเข้าหน้าประเมินราคา"
    description="V2 รวมคำค้น เช็คราคา ตีราคา และประเมินราคา ไว้ที่หน้าเดียว เพื่อลด cannibalization และให้ผู้ใช้เห็นทั้งข้อมูลที่ต้องส่ง ปัจจัยประเมิน และความต่างระหว่างราคาเบื้องต้นกับราคาสุดท้ายในหน้าเดียว"
    targetHref={target}
    targetLabel="ไปหน้าประเมินราคาโน๊ตบุ๊ค"
  />
</BaseLayout>
