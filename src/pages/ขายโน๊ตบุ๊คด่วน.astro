---
import BaseLayout from '../layouts/BaseLayout.astro';
import MigrationNotice from '../components/MigrationNotice.astro';
import { absoluteUrl } from '../lib/seo';

const target = '/ขายโน๊ตบุ๊ค/';
---

<BaseLayout
  title="ขายโน๊ตบุ๊คด่วน | ย้ายรวมหน้าขายโน๊ตบุ๊ค"
  description="คำค้นขายโน๊ตบุ๊คด่วนถูกรวมเข้าหน้าขายโน๊ตบุ๊ค เพื่อให้ขั้นตอนเตรียมเครื่อง ส่งประเมิน และส่งมอบอยู่ใน owner เดียว"
  canonical={absoluteUrl(target)}
  noindex={true}
>
  <MigrationNotice
    title="ขายโน๊ตบุ๊คด่วน ย้ายรวมเข้าหน้าขายโน๊ตบุ๊ค"
    description="ความเร็วในการขายขึ้นกับข้อมูลที่ส่งและขั้นตอนตรวจเครื่อง ไม่จำเป็นต้องมี Money Page แยกอีกหน้า V2 จึงรวม intent ขายด่วนเข้ากับ seller-flow owner เดียว"
    targetHref={target}
    targetLabel="ไปหน้าขายโน๊ตบุ๊ค"
  />
</BaseLayout>
