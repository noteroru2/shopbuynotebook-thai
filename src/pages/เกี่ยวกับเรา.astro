---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButtons from '../components/CTAButtons.astro';
import TrustProof from '../components/TrustProof.astro';
import { SITE, absoluteUrl, breadcrumbListSchema } from '../lib/seo';
import trustProof from '../data/rebuild-v2-trust-proof.json';

const title = 'เกี่ยวกับร้านรับซื้อโน๊ตบุ๊ค.com และผู้ดำเนินเว็บไซต์';
const description = 'ข้อมูลผู้ดำเนินเว็บไซต์ หน้าร้านจริง ช่องทางติดต่อ หลักการประเมินราคา และแนวทางจัดทำข้อมูลของร้านรับซื้อโน๊ตบุ๊ค.com';
const canonical = absoluteUrl('/เกี่ยวกับเรา/');
const schemas = [breadcrumbListSchema([
  { name: 'หน้าแรก', url: absoluteUrl('/') },
  { name: 'เกี่ยวกับเรา', url: canonical },
])];
---

<BaseLayout title={title} description={description} canonical={canonical} includeLocalBusiness={true} schemas={schemas}>
  <section class="mx-auto w-full max-w-6xl px-4 py-12 sm:py-16">
    <p class="text-sm font-extrabold text-emerald-700">ข้อมูลผู้ดำเนินเว็บไซต์</p>
    <h1 class="mt-2 max-w-4xl text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">ร้านรับซื้อโน๊ตบุ๊ค.com ดำเนินการโดยใคร</h1>
    <p class="mt-5 max-w-3xl text-base leading-8 text-slate-700">
      เว็บไซต์นี้ดำเนินการโดย {SITE.companyLegalName} และเชื่อมโยงกับหน้าร้านจริง {SITE.physicalStoreName} ในจังหวัดอุบลราชธานี
      ข้อมูลชื่อธุรกิจ ที่อยู่ โทรศัพท์ LINE และ Google Maps ใช้จากชุดข้อมูลกลางของเว็บไซต์เพื่อลดความคลาดเคลื่อนระหว่างหน้าเว็บ
    </p>
  </section>

  <TrustProof />

  <section id="หลักการ" class="mx-auto w-full max-w-6xl px-4 py-12">
    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        <p class="text-sm font-extrabold text-sky-700">หลักการจัดทำข้อมูล</p>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">แยกข้อมูลความรู้จากหน้ารับซื้อให้ชัด</h2>
        <ul class="mt-6 space-y-4 text-sm leading-7 text-slate-700">
          {trustProof.editorialPrinciples.map((item) => <li class="rounded-2xl border border-slate-200 bg-white p-4">{item}</li>)}
        </ul>
      </div>
      <div>
        <p class="text-sm font-extrabold text-amber-700">ข้อจำกัดของการประเมิน</p>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">ไม่ยืนยันราคาสุดท้ายก่อนตรวจเครื่องจริง</h2>
        <div class="mt-6 rounded-3xl border border-amber-200 bg-amber-50/70 p-6 text-sm leading-7 text-slate-700">
          การประเมินจากรูป รุ่น หรือสเปกเป็นกรอบเบื้องต้น เพราะยังอาจมีรายละเอียดที่มองไม่เห็น เช่น พอร์ตผิดปกติเป็นครั้งคราว จอมีเส้นเมื่อใช้งานนาน แบตบวมด้านใน หรือสเปกจริงไม่ตรงกับข้อมูลที่แจ้ง ราคาสุดท้ายจึงยืนยันหลังตรวจเครื่องจริงและตกลงซื้อขายเท่านั้น
        </div>
        <div class="mt-6 rounded-3xl border border-slate-200 bg-slate-50 p-6 text-sm leading-7 text-slate-700">
          เว็บไซต์ไม่อ้างว่ามีหน้าร้านหลายจังหวัด การกล่าวถึงพื้นที่อื่นหมายถึงพื้นที่ที่อาจให้บริการผ่านการส่งข้อมูล นัดหมาย หรือจัดส่งตามเงื่อนไขที่ทีมงานยืนยัน โดยหน้าร้านจริงอยู่ที่อุบลราชธานี
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pb-14">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-2xl font-black text-slate-950">ตรวจสอบข้อมูลร้านหรือเริ่มประเมิน</h2>
      <p class="mt-3 text-sm leading-7 text-slate-600">ดูตำแหน่งหน้าร้านผ่าน Google Maps หรือส่งรุ่น สเปก และรูปสภาพผ่าน LINE ก่อนตัดสินใจขายได้</p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a class="rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-extrabold text-slate-900" href={SITE.googleMapsUrl} target="_blank" rel="noopener noreferrer">เปิด Google Maps</a>
        <CTAButtons primaryText="ส่งข้อมูลเพื่อประเมิน" secondaryText="โทรสอบถาม" />
      </div>
    </div>
  </section>
</BaseLayout>
