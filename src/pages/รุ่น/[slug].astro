---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButtons from '../../components/CTAButtons.astro';
import { getCollection, render } from 'astro:content';
import { absoluteUrl } from '../../lib/seo';

const ALLOWED_MODELS = new Set([
  'macbook-pro-m3','macbook-pro-m4','macbook-air-m1','macbook-air-m2',
  'hp-omen-16','lenovo-legion-pro-7','lenovo-legion-pro','thinkpad-x1-carbon',
  'asus-rog-flow','asus-tuf-a15-f15','acer-nitro-v','lenovo-loq-15-16'
]);

export async function getStaticPaths() {
  const entries = await getCollection('brands');
  return entries
    .filter((entry) => ALLOWED_MODELS.has(entry.data.slug))
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.data.slug;
const title = `รับซื้อ ${entry.data.title} มือสอง | ร้านรับซื้อโน๊ตบุ๊ค.com`;
const description = entry.data.description;
const canonical = absoluteUrl(`/รุ่น/${slug}/`);
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={true}>
  <section class="mx-auto w-full max-w-5xl px-4 py-12 sm:py-16">
    <nav class="text-sm text-slate-500" aria-label="breadcrumb">
      <a class="hover:text-emerald-700" href="/">หน้าแรก</a> / <a class="hover:text-emerald-700" href="/รุ่น/">รุ่น</a> / {entry.data.title}
    </nav>
    <p class="mt-8 text-sm font-bold text-emerald-700">Model Owner</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">รับซื้อ {entry.data.title} มือสอง</h1>
    <p class="mt-5 max-w-3xl text-base leading-8 text-slate-700">{description}</p>
    <div class="mt-8"><CTAButtons primaryText={`ส่งรูป ${entry.data.title} เพื่อประเมิน`} secondaryText="โทรสอบถาม" /></div>
    <article class="prose prose-slate mt-12 max-w-none prose-headings:font-extrabold prose-a:text-emerald-700">
      <Content />
    </article>
    <div class="mt-12 rounded-3xl border border-slate-200 bg-slate-50 p-6">
      <h2 class="text-xl font-extrabold text-slate-950">อย่าประเมินจากชื่อซีรีส์อย่างเดียว</h2>
      <p class="mt-3 leading-7 text-slate-700">รุ่นเดียวกันอาจมี CPU GPU RAM SSD และปีที่ต่างกัน ควรส่งรหัสเครื่องหรือหน้าสเปกจริงพร้อมรูปสภาพก่อนทุกครั้ง</p>
    </div>
  </section>
</BaseLayout>
