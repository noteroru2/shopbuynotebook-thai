---
import ServicePageShell from '../components/ServicePageShell.astro';

const title = 'ขายโน๊ตบุ๊คมือสอง ส่งข้อมูลประเมินก่อนส่งมอบ | ร้านรับซื้อโน๊ตบุ๊ค.com';
const description = 'ขายโน๊ตบุ๊คมือสอง ส่งรุ่น สเปก รูปสภาพและอาการเพื่อประเมินเบื้องต้นก่อนตัดสินใจ พร้อมเช็กลิสต์สำรองข้อมูล ออกจากบัญชี และเตรียมอุปกรณ์ก่อนส่งมอบ';

const faqs = [
  {
    question: 'อยากขายโน๊ตบุ๊คต้องเริ่มจากอะไร?',
    answer: 'เริ่มจากส่งรุ่น สเปก รูปสภาพ อาการ และอุปกรณ์ที่มีเพื่อขอกรอบราคาเบื้องต้นก่อน จากนั้นค่อยตัดสินใจว่าจะนัดตรวจหรือจัดส่งเครื่อง',
  },
  {
    question: 'ขายด่วนต้องมีหน้าแยกไหม?',
    answer: 'ไม่ต้องครับ ใน V2 รวม intent ขายด่วนไว้ที่หน้านี้ ความเร็วขึ้นกับข้อมูลที่ส่งครบและขั้นตอนตรวจเครื่อง ไม่ใช่ URL แยก',
  },
  {
    question: 'ควรล้างข้อมูลก่อนส่งมอบไหม?',
    answer: 'ควรสำรองไฟล์ ออกจากบัญชีส่วนตัว และรีเซ็ตเครื่องก่อนส่งมอบจริง แต่ยังไม่จำเป็นต้องล้างเครื่องก่อนขั้นตอนขอกรอบราคาเบื้องต้น',
  },
  {
    question: 'ได้กรอบราคาแล้วต้องขายเลยไหม?',
    answer: 'ไม่จำเป็นครับ ใช้กรอบราคาเบื้องต้นประกอบการตัดสินใจได้ ราคาสุดท้ายยืนยันหลังตรวจเครื่องจริงและทั้งสองฝ่ายตกลงกัน',
  },
];
---

<ServicePageShell
  title={title}
  description={description}
  canonicalPath="/ขายโน๊ตบุ๊ค/"
  breadcrumbLabel="ขายโน๊ตบุ๊ค"
  serviceName="ขายโน๊ตบุ๊ค"
  h1="ขายโน๊ตบุ๊คมือสอง"
  h1Accent="ส่งข้อมูลประเมินก่อน แล้วค่อยเตรียมส่งมอบ"
  heroSubtitle="หน้า Seller Flow หลักของ V2 — ขอกรอบราคา เตรียมข้อมูล ตัดสินใจ และส่งมอบโดยใช้ขั้นตอนเดียว ไม่แยกหน้า ‘ขายด่วน’ อีกต่อไป"
  accentClass="text-amber-400"
  gradientFrom="from-amber-900/50"
  proseLinkClass="prose-a:text-amber-700 hover:prose-a:text-amber-600"
  faqs={faqs}
>
  <p class="lead">
    ถ้าต้องการ <strong>ขายโน๊ตบุ๊ค</strong> ให้เริ่มจากการส่งข้อมูลเครื่องเพื่อขอกรอบราคาเบื้องต้นก่อน ไม่จำเป็นต้องรีเซ็ตเครื่องหรือเดินทางมาร้านตั้งแต่ขั้นแรก
    หน้า <a href="/ประเมินราคา/">ประเมินราคาโน๊ตบุ๊ค</a> อธิบายปัจจัยที่ร้านใช้ดูราคา ส่วนหน้านี้เป็นลำดับงานฝั่งผู้ขายตั้งแต่เตรียมข้อมูลจนถึงส่งมอบ
  </p>

  <h2>ขั้นตอนขายโน๊ตบุ๊คใน V2</h2>
  <ol>
    <li><strong>ส่งข้อมูลเครื่อง:</strong> รุ่นย่อย CPU GPU RAM SSD รูปสภาพ อาการ และอุปกรณ์ที่มี</li>
    <li><strong>รับกรอบราคาเบื้องต้น:</strong> ใช้ข้อมูลจริงของเครื่องเป็นฐาน หากข้อมูลไม่ครบอาจต้องถามเพิ่ม</li>
    <li><strong>ตัดสินใจ:</strong> เปรียบเทียบหรือคิดต่อได้ ยังไม่ผูกมัดว่าต้องขาย</li>
    <li><strong>เตรียมเครื่อง:</strong> เมื่อจะส่งมอบจริง จึงสำรองข้อมูล ออกจากบัญชี และเตรียมที่ชาร์จ/อุปกรณ์</li>
    <li><strong>ตรวจและยืนยัน:</strong> ราคาสุดท้ายยืนยันหลังตรวจเครื่องจริงและตกลงกันอีกครั้ง</li>
  </ol>

  <h2>ข้อมูลที่ควรส่งก่อนขอราคา</h2>
  <ul>
    <li><strong>รุ่นเต็ม:</strong> ถ่ายสติ๊กเกอร์ใต้เครื่องหรือหน้าข้อมูลระบบให้เห็นรุ่นย่อย</li>
    <li><strong>สเปก:</strong> CPU, GPU ถ้ามี, RAM และ SSD/HDD</li>
    <li><strong>รูปสภาพ:</strong> จอ คีย์บอร์ด ฝาบน ก้นเครื่อง มุมและรอยตำหนิ</li>
    <li><strong>อาการ:</strong> เช่น <a href="/อาการ/เปิดไม่ติด/">เปิดไม่ติด</a>, <a href="/อาการ/จอแตก/">จอแตก</a>, <a href="/อาการ/แบตเสื่อม/">แบตเสื่อม</a> หรือพอร์ต/บานพับมีปัญหา</li>
    <li><strong>อุปกรณ์:</strong> ที่ชาร์จ กล่อง ใบเสร็จ หรือแจ้งชัดว่าขาดอะไร</li>
  </ul>

  <h2>ถ้าต้องการขายเร็ว ทำอะไรให้ครบก่อน</h2>
  <p>
    V2 ไม่แยกหน้า “ขายโน๊ตบุ๊คด่วน” อีกแล้ว เพราะความเร็วของการปิดงานไม่ได้มาจากหน้าเว็บคนละ URL แต่เกิดจากข้อมูลที่ครบและเงื่อนไขที่ชัด
    ถ้าต้องการลดการถามกลับหลายรอบ ให้ส่งรูป 4–6 มุม พร้อมสเปกและตำหนิที่เห็นจริงตั้งแต่ข้อความแรก
  </p>
  <ul>
    <li>รุ่น/สเปกครบ ลดเวลาค้นรุ่นผิด</li>
    <li>รูปตำหนิชัด ลดความคลาดเคลื่อนระหว่างกรอบราคากับตอนตรวจ</li>
    <li>แจ้งจังหวัดหรือวิธีส่งมอบที่สะดวก เพื่อคุยขั้นตอนต่อได้ตรง</li>
    <li>ยังไม่ต้องรีบล้างข้อมูลจนกว่าจะตัดสินใจส่งมอบจริง</li>
  </ul>

  <h2>ก่อนส่งมอบจริง ควรเตรียมอะไร</h2>
  <ol>
    <li><strong>สำรองข้อมูล:</strong> ย้ายไฟล์งาน รูปและเอกสารสำคัญออกก่อน</li>
    <li><strong>ออกจากบัญชี:</strong> Microsoft Account, Apple ID, Google, LINE, Browser Sync และ Find My/Activation Lock ที่เกี่ยวข้อง</li>
    <li><strong>รีเซ็ตเครื่อง:</strong> ทำเมื่อพร้อมส่งมอบจริง ไม่จำเป็นต้องทำก่อนขอประเมิน</li>
    <li><strong>รวบรวมอุปกรณ์:</strong> ที่ชาร์จ กล่อง ใบเสร็จ หรืออุปกรณ์เสริมที่เคยแจ้งไว้</li>
    <li><strong>เครื่ององค์กร:</strong> เตรียมหลักฐานสิทธิ์หรือการปลด Asset Tag ตามกรณี</li>
  </ol>

  <h2>เลือกหน้าต่อไปตามสถานการณ์</h2>
  <ul>
    <li>อยากรู้กรอบราคาก่อน → <a href="/ประเมินราคา/">ประเมินราคาโน๊ตบุ๊ค</a></li>
    <li>เครื่องผ่านการใช้งานมาหลายปี → <a href="/รับซื้อโน๊ตบุ๊คมือสอง/">รับซื้อโน๊ตบุ๊คมือสอง</a></li>
    <li>อยากดูตามยี่ห้อ → <a href="/แบรนด์/">แบรนด์โน๊ตบุ๊คที่รับประเมิน</a></li>
    <li>เครื่องมีอาการ → <a href="/อาการ/">ดูการประเมินตามอาการ</a></li>
    <li>อยู่หน้าร้านอุบล → <a href="/พื้นที่/อุบลราชธานี/">รับซื้อโน๊ตบุ๊คอุบลราชธานี</a></li>
  </ul>

  <h2>หลักสำคัญก่อนตัดสินใจ</h2>
  <p>
    กรอบราคาจากรูปเป็นข้อมูลเบื้องต้น ไม่ใช่ราคาสุดท้าย หากเครื่องจริงต่างจากข้อมูลที่ส่ง ร้านต้องตรวจและอธิบายก่อนยืนยันราคาใหม่
    ผู้ขายสามารถตัดสินใจไม่ขายได้ก่อนตกลงส่งมอบ ส่วนหน้าร้านจริงอยู่จังหวัดอุบลราชธานี จังหวัดอื่นใช้การนัดหรือจัดส่งตามเงื่อนไขที่ยืนยันกัน
  </p>
</ServicePageShell>
