---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButtons from '../../components/CTAButtons.astro';
import AuthorityLinks from '../../components/AuthorityLinks.astro';
import { getCollection, render } from 'astro:content';
import { absoluteUrl } from '../../lib/seo';

const ALLOWED_LOCATIONS = new Set(['อุบลราชธานี']);

export async function getStaticPaths() {
  const entries = await getCollection('locations');
  return entries.filter((entry) => ALLOWED_LOCATIONS.has(entry.data.slug)).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.data.slug;
const title = `รับซื้อโน๊ตบุ๊ค ${entry.data.title} | ร้านรับซื้อโน๊ตบุ๊ค.com`;
const description = entry.data.description;
const canonical = absoluteUrl(`/พื้นที่/${slug}/`);
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={true} includeLocalBusiness={slug === 'อุบลราชธานี'}>
  <section class="mx-auto w-full max-w-5xl px-4 py-12 sm:py-16">
    <nav class="text-sm text-slate-500" aria-label="breadcrumb"><a class="hover:text-emerald-700" href="/">หน้าแรก</a> / <a class="hover:text-emerald-700" href="/พื้นที่/">พื้นที่</a> / {entry.data.title}</nav>
    <p class="mt-8 text-sm font-bold text-emerald-700">หน้าร้านและพื้นที่ให้บริการ</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">รับซื้อโน๊ตบุ๊ค {entry.data.title}</h1>
    <p class="mt-5 max-w-3xl text-base leading-8 text-slate-700">{description}</p>
    <div class="mt-8"><CTAButtons primaryText="ส่งรูปเพื่อประเมินก่อนนัด" secondaryText="โทรสอบถาม" /></div>
    <article class="prose prose-slate mt-12 max-w-none prose-headings:font-extrabold prose-a:text-emerald-700"><Content /></article>
    <div class="mt-12 rounded-3xl border border-emerald-200 bg-emerald-50/70 p-6">
      <h2 class="text-xl font-extrabold text-slate-950">หน้าร้านจริงอยู่จังหวัดอุบลราชธานี</h2>
      <p class="mt-3 leading-7 text-slate-700">การประเมินเบื้องต้นทำได้จากรูปและข้อมูลเครื่อง ส่วนการรับซื้อและราคาสุดท้ายยืนยันหลังตรวจเครื่องจริง</p>
    </div>
  </section>
  <AuthorityLinks context="location" />
</BaseLayout>
