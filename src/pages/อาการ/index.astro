---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ประเมินโน๊ตบุ๊คตามอาการและสภาพ | ร้านรับซื้อโน๊ตบุ๊ค.com"
  description="รวมแนวทางประเมินโน๊ตบุ๊คตามอาการ เช่น เปิดไม่ติด จอแตก แบตเสื่อม โดนน้ำ และไม่มีที่ชาร์จ"
  noindex={true}
>
  <section class="mx-auto w-full max-w-6xl px-4 py-14 sm:py-20">
    <p class="text-sm font-bold text-emerald-700">Condition Hub</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">โน๊ตบุ๊คมีอาการเสีย ยังประเมินได้ไหม</h1>
    <p class="mt-5 max-w-3xl text-base leading-8 text-slate-700">
      หน้านี้เป็น Hub สำหรับอาการของเครื่องโดยเฉพาะ ไม่ปนกับหน้าแบรนด์หรือพื้นที่ เพื่อให้ Google และผู้ใช้เข้าใจว่าแต่ละหน้าตอบคำถามด้านสภาพเครื่องโดยตรง
    </p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {['เปิดไม่ติด','จอแตก','แบตเสื่อม','โดนน้ำ','ไม่มีที่ชาร์จ','บานพับแตก','คีย์บอร์ดเสีย','เมนบอร์ดเสีย','เครื่องเก่า'].map((condition) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="font-extrabold text-slate-950">{condition}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">แยก intent เป็นอาการเดียวต่อหน้า และเปิด index เฉพาะอาการที่ผ่าน evidence gate</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
