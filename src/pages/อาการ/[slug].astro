---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButtons from '../../components/CTAButtons.astro';
import AuthorityLinks from '../../components/AuthorityLinks.astro';
import { getCollection, render } from 'astro:content';
import { absoluteUrl } from '../../lib/seo';

const ALLOWED_CONDITIONS = new Set(['เปิดไม่ติด','จอแตก','แบตเสื่อม','โดนน้ำ','ไม่มีที่ชาร์จ','บานพับแตก','คีย์บอร์ดเสีย','เมนบอร์ดเสีย','เครื่องเก่า']);

export async function getStaticPaths() {
  const entries = await getCollection('conditions');
  return entries.filter((entry) => ALLOWED_CONDITIONS.has(entry.data.slug)).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.data.slug;
const title = `รับซื้อโน๊ตบุ๊ค${entry.data.title} ประเมินตามสภาพจริง | ร้านรับซื้อโน๊ตบุ๊ค.com`;
const description = entry.data.description;
const canonical = absoluteUrl(`/อาการ/${slug}/`);
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={true}>
  <section class="mx-auto w-full max-w-5xl px-4 py-12 sm:py-16">
    <nav class="text-sm text-slate-500" aria-label="breadcrumb"><a class="hover:text-emerald-700" href="/">หน้าแรก</a> / <a class="hover:text-emerald-700" href="/อาการ/">อาการ</a> / {entry.data.title}</nav>
    <p class="mt-8 text-sm font-bold text-emerald-700">ประเมินเครื่องตามอาการและสภาพ</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">โน๊ตบุ๊ค{entry.data.title} ยังประเมินขายได้ไหม</h1>
    <p class="mt-5 max-w-3xl text-base leading-8 text-slate-700">{description}</p>
    <div class="mt-8"><CTAButtons primaryText="ส่งรูปและอาการเพื่อประเมิน" secondaryText="โทรสอบถาม" /></div>
    <article class="prose prose-slate mt-12 max-w-none prose-headings:font-extrabold prose-a:text-emerald-700"><Content /></article>
    <div class="mt-12 rounded-3xl border border-amber-200 bg-amber-50/70 p-6">
      <h2 class="text-xl font-extrabold text-slate-950">แจ้งอาการตามจริงก่อนประเมิน</h2>
      <p class="mt-3 leading-7 text-slate-700">รูปหรือวิดีโอที่เห็นอาการชัดช่วยลดความคลาดเคลื่อน ราคาสุดท้ายยังขึ้นกับรุ่น สเปก สภาพรวม และผลตรวจเครื่องจริง</p>
    </div>
  </section>
  <AuthorityLinks context="condition" />
</BaseLayout>
