---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import BrandGrid from '../components/BrandGrid.astro';
import NotebookTypesSection from '../components/NotebookTypesSection.astro';
import ConditionGrid from '../components/ConditionGrid.astro';
import PriceFactors from '../components/PriceFactors.astro';
import PhotoGuide from '../components/PhotoGuide.astro';
import TrustGallery from '../components/TrustGallery.astro';
import SafetySection from '../components/SafetySection.astro';
import FAQ from '../components/FAQ.astro';
import CTAButtons from '../components/CTAButtons.astro';
import FinalCtaBanner from '../components/FinalCtaBanner.astro';
import ServiceAreasSection from '../components/ServiceAreasSection.astro';
import HomeFeaturedArticles from '../components/HomeFeaturedArticles.astro';
import { getCollection } from 'astro:content';
import { HOME_FEATURED_BLOG_SLUGS } from '../data/home-featured-blog';
import { faqPageSchema, absoluteUrl } from '../lib/seo';
import { itemListSchema } from '../lib/schema';

const title = 'รับซื้อโน๊ตบุ๊ค ประเมินตามรุ่น สเปก และสภาพจริง | ร้านรับซื้อโน๊ตบุ๊ค.com';
const description =
  'รับซื้อโน๊ตบุ๊ค ส่งรูป รุ่น สเปก และสภาพเพื่อประเมินเบื้องต้น ราคาสุดท้ายยืนยันหลังตรวจเครื่อง มีหน้าร้านอุบลราชธานี จังหวัดอื่นนัดหรือจัดส่งตามเงื่อนไข';

const toSlug = (p: { id: string; data: { slug?: string } }) =>
  p.data.slug ? p.data.slug : String(p.id).replace(/\.(md|mdx)$/i, '');

const allBlogPosts = await getCollection('blog');
const postBySlug = new Map(allBlogPosts.map((p) => [toSlug(p), p]));
const homeFeaturedPosts = HOME_FEATURED_BLOG_SLUGS
  .map((s) => postBySlug.get(s))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));
const featuredArticleListItems = homeFeaturedPosts.map((p) => ({
  name: p.data.title,
  url: absoluteUrl(`/blog/${toSlug(p)}/`),
}));

const heroImageSrc = '/images/home/rubsue-notebook-hero-team-640.webp';
const heroImageSrcset =
  '/images/home/rubsue-notebook-hero-team-640.webp 640w, /images/rubsue-notebook-hero-team.webp 1024w';
const heroImageSizes = '(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 480px';

const faqs = [
  {
    question: 'รับซื้อโน๊ตบุ๊คเสียไหม?',
    answer:
      'รับครับ เรารับซื้อทั้งเครื่องใช้งานปกติและเครื่องเสีย “บางอาการ” เช่น เปิดไม่ติด จอแตก แบตเสื่อม คีย์บอร์ดบางปุ่มเสีย ราคาจะขึ้นกับรุ่น/สเปก/สภาพรวม และอุปกรณ์ที่มี',
  },
  {
    question: 'รับซื้อโน๊ตบุ๊คไม่มีที่ชาร์จไหม?',
    answer:
      'รับครับ แค่แจ้งว่าไม่มีที่ชาร์จเพื่อให้ประเมินตรงขึ้น ราคามักปรับตามความครบของอุปกรณ์ แต่ยังรับซื้อได้ตามสภาพจริง',
  },
  {
    question: 'เช็คราคาโน๊ตบุ๊คก่อนขายได้ไหม?',
    answer:
      'ได้ครับ ส่งรูป รุ่น สเปก สภาพและอาการทาง LINE เพื่อประเมินเบื้องต้น ราคาสุดท้ายจะยืนยันหลังตรวจเครื่องจริง',
  },
  {
    question: 'อยู่จังหวัดอื่นขายโน๊ตบุ๊คอย่างไร?',
    answer:
      'ส่งรูปและข้อมูลประเมินเบื้องต้นก่อน การนัดรับขึ้นอยู่กับพื้นที่ ตารางงาน และการยืนยันจากทีมงาน หรือสอบถามขั้นตอนจัดส่งเครื่องมาตรวจได้ หน้าร้านจริงอยู่จังหวัดอุบลราชธานี',
  },
  {
    question: 'ราคาประเมินจากรูปเป็นราคาสุดท้ายหรือไม่?',
    answer:
      'ไม่ใช่ครับ ราคาเบื้องต้นอ้างอิงข้อมูลที่ส่งมา ราคาสุดท้ายยืนยันหลังตรวจรุ่น สเปก สภาพและอาการจริง โดยลูกค้าไม่จำเป็นต้องตกลงขาย',
  },
  {
    question: 'ก่อนขายโน๊ตบุ๊คต้องล้างข้อมูลไหม?',
    answer:
      'แนะนำให้สำรองข้อมูลและล้างเครื่องก่อนขายเสมอเพื่อความปลอดภัยของข้อมูลส่วนตัว หากไม่สะดวก เราช่วยแนะนำขั้นตอน reset/ล้างข้อมูลอย่างปลอดภัยตามระบบได้',
  },
  {
    question: 'เครื่องติดรหัสขายได้ไหม?',
    answer:
      'กรณีติดรหัส Windows/Apple ID ต้องปลดล็อกได้ก่อนเพื่อความถูกต้องในการรับซื้อ แนะนำเตรียมข้อมูลบัญชีเพื่อปลดก่อนนัดส่งเครื่อง',
  },
  {
    question: 'โน๊ตบุ๊คเก่าหลายปียังขายได้ไหม?',
    answer:
      'ส่งประเมินได้ครับ อายุเครื่องมีผลต่อกรอบราคา แต่รุ่น สเปกที่ยังใช้งานได้ และสภาพจริงสำคัญกว่าปีผลิตเพียงอย่างเดียว ส่งรูปมาดูก่อนได้โดยไม่ต้องขายทันที',
  },
  {
    question: 'โน๊ตบุ๊คไม่มีประกันหรือประกันหมดแล้วรับซื้อไหม?',
    answer:
      'รับประเมินครับ การรับซื้อมือสองดูจากรุ่น สเปก สภาพ และอุปกรณ์เป็นหลัก ไม่จำเป็นต้องมีประกันเหลืออยู่ แต่ถ้ายังมีใบเสร็จหรือหลักฐานการซื้อ แจ้งมาประกอบได้',
  },
];

const schemas = [
  faqPageSchema(faqs),
  ...(featuredArticleListItems.length > 0
    ? [
        itemListSchema({
          name: 'บทความแนะนำเกี่ยวกับรับซื้อโน๊ตบุ๊ค เช็คราคา และประเมินราคา',
          url: absoluteUrl('/#featured-articles'),
          items: featuredArticleListItems,
        }),
      ]
    : []),
];
---
<BaseLayout
  title={title}
  description={description}
  schemas={schemas}
  includeLocalBusiness={true}
  lcpImageSrc={heroImageSrc}
  lcpImageSrcset={heroImageSrcset}
  lcpImageSizes={heroImageSizes}
>
  <div class="absolute inset-x-0 top-0 -z-10 h-[520px] bg-gradient-to-b from-slate-50/80 to-transparent"></div>
  <Hero
    title="รับซื้อโน๊ตบุ๊ค ประเมินตามรุ่น สเปก และสภาพจริง"
    titleHtml={`<span class="block"><span class="bg-gradient-to-r from-emerald-600 to-sky-600 bg-clip-text text-transparent">รับซื้อโน๊ตบุ๊ค</span></span><span class="mt-1 block">ประเมินตามรุ่น สเปก <span class="relative inline-flex items-center rounded-full bg-[#FACC15]/45 px-3 py-1 text-slate-900">และสภาพจริง</span></span>`}
    subtitle="รับซื้อเฉพาะโน๊ตบุ๊คและเครื่องพกพาในหมวดที่เว็บไซต์รองรับ ส่งรูปทาง LINE เพื่อประเมินเบื้องต้น ราคาสุดท้ายยืนยันหลังตรวจเครื่องจริง หน้าร้านอยู่จังหวัดอุบลราชธานี ส่วนจังหวัดอื่นต้องยืนยันวิธีนัดหรือจัดส่งก่อน"
    imageSrc={heroImageSrc}
    imageSrcset={heroImageSrcset}
    imageSizes={heroImageSizes}
    imageWidth={640}
    imageHeight={480}
    imageAlt="ทีมงานตรวจสภาพโน๊ตบุ๊คก่อนประเมินราคา"
  />

  <ProcessSteps />

  <section id="evaluation-checklist" class="mx-auto w-full max-w-6xl scroll-mt-24 px-4 pt-12" aria-labelledby="evaluation-checklist-heading">
    <div class="rounded-3xl border border-emerald-200 bg-emerald-50/60 p-6 shadow-sm sm:p-8">
      <h2 id="evaluation-checklist-heading" class="text-xl font-extrabold text-slate-900">เตรียมข้อมูลก่อนประเมิน</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-700">ข้อมูลครบช่วยให้ตรวจรุ่นและสภาพได้ตรงขึ้น แต่ยังไม่ใช่ราคาสุดท้าย</p>
      <ul class="mt-5 grid gap-3 text-sm text-slate-800 sm:grid-cols-2 lg:grid-cols-3">
        {[
          'ยี่ห้อและรุ่นเต็ม',
          'CPU',
          'GPU ถ้ามี',
          'RAM และ SSD',
          'สภาพจอและตัวเครื่อง',
          'สุขภาพแบตเตอรี่หรืออาการแบต',
          'อาการเสียหรือตำหนิ',
          'Adapter กล่อง ใบเสร็จ หรืออุปกรณ์ที่มี',
          'จังหวัดหรือวิธีที่สะดวกในการส่งมอบ',
        ].map((item) => (
          <li class="flex gap-3 rounded-2xl border border-emerald-100 bg-white p-4">
            <span class="font-extrabold text-emerald-700" aria-hidden="true">✓</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <PhotoGuide />
  <NotebookTypesSection />
  <PriceFactors />
  <ConditionGrid />
  <BrandGrid />
  <ServiceAreasSection />
  <TrustGallery />
  <SafetySection />
  <FAQ faqs={faqs} />
  <HomeFeaturedArticles />

  <FinalCtaBanner>
    <CTAButtons primaryText="แอดไลน์ @webuy ส่งรูปประเมินราคา" secondaryText="โทร" />
  </FinalCtaBanner>
</BaseLayout>
