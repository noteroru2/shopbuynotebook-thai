---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButtons from '../components/CTAButtons.astro';
import FAQ from '../components/FAQ.astro';
import { faqPageSchema } from '../lib/seo';

const title = 'รับซื้อโน๊ตบุ๊คมือสอง ประเมินตามรุ่น สเปก และสภาพจริง | ร้านรับซื้อโน๊ตบุ๊ค.com';
const description =
  'รับซื้อโน๊ตบุ๊คมือสอง ส่งรุ่น สเปก รูปสภาพ แบตเตอรี่ และอุปกรณ์เพื่อประเมินเบื้องต้น ราคาสุดท้ายยืนยันหลังตรวจเครื่องจริง หน้าร้านอยู่จังหวัดอุบลราชธานี';
const heroImage = '/images/home/rubsue-notebook-hero-team-640.webp';

const faqs = [
  {
    question: 'รับซื้อโน๊ตบุ๊คยี่ห้ออะไรบ้าง?',
    answer:
      'รับประเมินหลายแบรนด์ เช่น ASUS, Acer, Lenovo, HP, Dell, MSI, MacBook และ Microsoft Surface โดยต้องดูรุ่นย่อย สเปก และสภาพจริงก่อนยืนยันราคา',
  },
  {
    question: 'โน๊ตบุ๊คเสียหรือเปิดไม่ติดยังประเมินได้ไหม?',
    answer:
      'ประเมินเบื้องต้นได้หลายอาการ เช่น เปิดไม่ติด จอแตก แบตเสื่อม หรือไม่มีที่ชาร์จ กรุณาส่งรูปและอาการตามจริงเพื่อดูความเป็นไปได้ก่อน',
  },
  {
    question: 'ต้องส่งข้อมูลอะไรเพื่อเช็คราคา?',
    answer:
      'ควรส่งชื่อรุ่นเต็ม CPU GPU ถ้ามี RAM SSD รูปจอและตัวเครื่อง สุขภาพแบตเตอรี่หรือตำหนิ พร้อมแจ้งอุปกรณ์ เช่น ที่ชาร์จ กล่อง หรือใบเสร็จถ้ามี',
  },
  {
    question: 'ราคาที่ประเมินจากรูปเป็นราคาสุดท้ายหรือไม่?',
    answer:
      'ไม่ใช่ ราคาเบื้องต้นอ้างอิงข้อมูลที่ส่งมา ส่วนราคาสุดท้ายยืนยันหลังตรวจรุ่น สเปก สภาพ อาการ และอุปกรณ์ของเครื่องจริง',
  },
  {
    question: 'ร้านอยู่ที่ไหน?',
    answer:
      'หน้าร้านจริงอยู่จังหวัดอุบลราชธานี พื้นที่อื่นควรส่งข้อมูลประเมินก่อน แล้วสอบถามวิธีนัดหรือจัดส่งตามเงื่อนไขที่ทีมงานยืนยัน',
  },
  {
    question: 'ขายหลายเครื่องหรือเครื่องบริษัทได้ไหม?',
    answer:
      'ได้ หากเป็นล็อตหรือทรัพย์สินบริษัทควรแจ้งจำนวน รุ่น สเปก สภาพ และข้อกำหนดด้านเอกสารเพื่อประเมินเป็นงานแยกจากลูกค้ารายเครื่อง',
  },
];

const schemas = [faqPageSchema(faqs)];

const evaluationFactors = [
  ['รุ่นและปีของเครื่อง', 'ชื่อซีรีส์อย่างเดียวอาจมีหลายสเปกย่อย ควรส่งรหัสรุ่นหรือหน้าข้อมูลระบบ'],
  ['CPU / GPU / RAM / SSD', 'สเปกจริงมีผลต่อมูลค่า โดยเฉพาะ Gaming Notebook และรุ่นที่มีหลาย configuration'],
  ['สภาพจอและตัวเครื่อง', 'รอยแตก บุบ บานพับ พอร์ต คีย์บอร์ด และจอมีผลต่อการประเมิน'],
  ['แบตเตอรี่และอาการ', 'Battery Health, แบตบวม, เปิดไม่ติด, ร้อน หรืออาการผิดปกติควรแจ้งตามจริง'],
  ['อุปกรณ์ที่มี', 'ที่ชาร์จ กล่อง ใบเสร็จ และอุปกรณ์เดิมของเครื่องช่วยให้ประเมินได้ครบขึ้น'],
  ['ความต้องการตลาด', 'รุ่นและสเปกที่ตลาดมือสองต้องการต่างกัน จึงไม่ควรใช้ราคากลางเดียวกับทุกเครื่อง'],
];

const routes = [
  { href: '/ประเมินราคา/', title: 'ประเมินราคาโน๊ตบุ๊ค', text: 'สำหรับคนที่ต้องการรู้ว่าควรส่งข้อมูลอะไรและร้านดูปัจจัยใดก่อนยืนยันราคา' },
  { href: '/แบรนด์/', title: 'เลือกตามแบรนด์', text: 'ASUS, Acer, Lenovo, HP, Dell, MSI, MacBook และ Surface' },
  { href: '/รุ่น/', title: 'เลือกตามรุ่น', text: 'เฉพาะรุ่นที่มีข้อมูลและเหตุผลเพียงพอในการทำหน้าประเมินเฉพาะ' },
  { href: '/อาการ/', title: 'เลือกตามอาการ', text: 'เปิดไม่ติด จอแตก แบตเสื่อม โดนน้ำ ไม่มีที่ชาร์จ และอาการสำคัญ' },
  { href: '/พื้นที่/', title: 'พื้นที่ให้บริการ', text: 'หน้าร้านจริงที่อุบลราชธานี และพื้นที่อื่นที่ผ่านเกณฑ์ข้อมูล/บริการจริง' },
  { href: '/ขายโน๊ตบุ๊ค/', title: 'เตรียมเครื่องก่อนขาย', text: 'ดูสิ่งที่ควรสำรองข้อมูล ตรวจสเปก และเตรียมอุปกรณ์ก่อนส่งมอบ' },
];
---

<BaseLayout
  title={title}
  description={description}
  schemas={schemas}
  includeLocalBusiness={true}
  lcpImageSrc={heroImage}
>
  <section class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-12 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:py-20">
      <div>
        <p class="inline-flex rounded-full bg-emerald-100 px-3 py-1 text-sm font-extrabold text-emerald-800">
          ร้านรับซื้อโน๊ตบุ๊คโดยเฉพาะ
        </p>
        <h1 class="mt-5 max-w-4xl text-4xl font-black tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
          รับซื้อโน๊ตบุ๊คมือสอง
          <span class="mt-2 block text-emerald-700">ประเมินจากรุ่น สเปก และสภาพจริง</span>
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-slate-700 sm:text-lg">
          ส่งรูปเครื่องพร้อมรุ่น CPU GPU RAM SSD สภาพ แบตเตอรี่ และอุปกรณ์ที่มี เพื่อประเมินเบื้องต้นก่อนตัดสินใจขาย
          ราคาสุดท้ายยืนยันหลังตรวจเครื่องจริง ไม่ใช้ชื่อรุ่นอย่างเดียวในการตีราคา
        </p>
        <div class="mt-8">
          <CTAButtons primaryText="ส่งรูปและสเปกเพื่อประเมิน" secondaryText="โทรสอบถาม" />
        </div>
        <div class="mt-7 grid max-w-2xl gap-3 text-sm text-slate-700 sm:grid-cols-3">
          <div class="rounded-2xl border border-slate-200 bg-white p-4"><strong class="block text-slate-950">หน้าร้านจริง</strong>อุบลราชธานี</div>
          <div class="rounded-2xl border border-slate-200 bg-white p-4"><strong class="block text-slate-950">ประเมินก่อน</strong>ส่งข้อมูลได้ก่อนตัดสินใจ</div>
          <div class="rounded-2xl border border-slate-200 bg-white p-4"><strong class="block text-slate-950">ดูเครื่องจริง</strong>ก่อนยืนยันราคาสุดท้าย</div>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-emerald-100/70 blur-2xl"></div>
        <img
          src={heroImage}
          width="640"
          height="480"
          loading="eager"
          fetchpriority="high"
          alt="ทีมงานตรวจสภาพโน๊ตบุ๊คก่อนประเมินราคา"
          class="aspect-[4/3] w-full rounded-[2rem] border border-slate-200 bg-white object-cover shadow-xl"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 py-14 sm:py-20">
    <div class="max-w-3xl">
      <p class="text-sm font-extrabold text-emerald-700">ประเมินจากข้อมูลอะไร</p>
      <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">เครื่องชื่อรุ่นเหมือนกัน อาจได้ราคาไม่เท่ากัน</h2>
      <p class="mt-4 leading-8 text-slate-700">
        โน๊ตบุ๊คหนึ่งซีรีส์มีหลาย CPU, GPU, RAM, SSD และปีผลิต การประเมินจึงต้องแยกข้อเท็จจริงของรุ่นออกจากสภาพเครื่อง
      </p>
    </div>
    <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {evaluationFactors.map(([factor, detail]) => (
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-extrabold text-slate-950">{factor}</h3>
          <p class="mt-3 text-sm leading-7 text-slate-600">{detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto w-full max-w-6xl px-4 py-14 sm:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-extrabold text-emerald-700">เลือกข้อมูลให้ตรงเครื่อง</p>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-slate-950">ไม่ต้องค้นผ่านหน้าหลายร้อยหน้า</h2>
        <p class="mt-4 leading-8 text-slate-700">
          โครงสร้างใหม่แยกแบรนด์ รุ่น อาการ พื้นที่ และการประเมินราคาออกจากกัน เพื่อให้แต่ละหน้ามีหน้าที่ชัดเจนและค้นข้อมูลได้ตรงกว่าเดิม
        </p>
      </div>
      <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {routes.map((route) => (
          <a href={route.href} class="group rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md">
            <h3 class="text-lg font-extrabold text-slate-950 group-hover:text-emerald-700">{route.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">{route.text}</p>
            <span class="mt-5 inline-flex text-sm font-bold text-emerald-700">ดูรายละเอียด →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto grid w-full max-w-6xl gap-8 px-4 py-14 lg:grid-cols-2 lg:py-20">
    <div class="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm sm:p-8">
      <p class="text-sm font-extrabold text-emerald-700">ขั้นตอนประเมิน</p>
      <h2 class="mt-2 text-2xl font-black text-slate-950">ส่งข้อมูลให้ครบก่อน จะคุยราคาได้ตรงกว่า</h2>
      <ol class="mt-6 space-y-5">
        {[
          ['1', 'ถ่ายรูปเครื่อง', 'จอ คีย์บอร์ด ฝาบน ก้นเครื่อง ตำหนิ และอุปกรณ์'],
          ['2', 'ส่งรุ่นและสเปก', 'CPU GPU RAM SSD หรือภาพหน้าข้อมูลระบบ'],
          ['3', 'แจ้งสภาพและอาการ', 'แบตเสื่อม เปิดไม่ติด จอแตก พอร์ตหรือบานพับมีปัญหาให้แจ้งตามจริง'],
          ['4', 'รับการประเมินเบื้องต้น', 'ใช้ข้อมูลที่ส่งมาเพื่อประเมินกรอบก่อนนัดหรือตัดสินใจส่งเครื่อง'],
          ['5', 'ตรวจเครื่องและยืนยันราคา', 'ราคาสุดท้ายยืนยันหลังตรวจรายละเอียดของเครื่องจริง'],
        ].map(([n, heading, body]) => (
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-950 text-sm font-black text-white">{n}</span>
            <div><strong class="block text-slate-950">{heading}</strong><span class="mt-1 block text-sm leading-6 text-slate-600">{body}</span></div>
          </li>
        ))}
      </ol>
    </div>

    <div class="rounded-3xl border border-emerald-200 bg-emerald-50/60 p-7 sm:p-8">
      <p class="text-sm font-extrabold text-emerald-700">ข้อมูลร้านและพื้นที่</p>
      <h2 class="mt-2 text-2xl font-black text-slate-950">หน้าร้านอยู่จังหวัดอุบลราชธานี</h2>
      <p class="mt-5 leading-8 text-slate-700">
        สำหรับลูกค้าอุบลราชธานีสามารถสอบถามการนำเครื่องเข้าตรวจได้ ส่วนจังหวัดอื่นให้ส่งรูปและข้อมูลประเมินก่อน แล้วค่อยยืนยันวิธีนัดหรือจัดส่งกับทีมงาน
        เว็บไซต์จะไม่อ้างว่ามีสาขาในจังหวัดที่ไม่มีหน้าร้านจริง
      </p>
      <div class="mt-7 rounded-2xl bg-white p-5 text-sm leading-7 text-slate-700 shadow-sm">
        <strong class="block text-slate-950">ก่อนส่งมอบเครื่อง</strong>
        แนะนำสำรองข้อมูล ออกจากบัญชีสำคัญ และล้างข้อมูลส่วนตัวเมื่อพร้อมขาย หากยังไม่แน่ใจสามารถสอบถามขั้นตอนก่อนส่งเครื่องได้
      </div>
    </div>
  </section>

  <FAQ title="คำถามก่อนส่งโน๊ตบุ๊คมาประเมิน" faqs={faqs} />

  <section class="mx-auto w-full max-w-6xl px-4 py-14 sm:py-20">
    <div class="rounded-[2rem] bg-slate-950 p-8 text-white sm:p-10 lg:flex lg:items-center lg:justify-between lg:gap-8">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-black sm:text-3xl">มีรุ่นและรูปเครื่องแล้ว ส่งประเมินได้เลย</h2>
        <p class="mt-3 leading-7 text-slate-300">ส่งข้อมูลให้ครบที่สุดเท่าที่มี เพื่อให้ทีมงานดูรุ่น สเปก และสภาพได้ตรงก่อนนัดตรวจเครื่อง</p>
      </div>
      <div class="mt-7 lg:mt-0"><CTAButtons primaryText="ส่งรูปประเมินทาง LINE" secondaryText="โทรสอบถาม" /></div>
    </div>
  </section>
</BaseLayout>
