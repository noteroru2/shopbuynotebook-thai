---
import BaseLayout from '../layouts/BaseLayout.astro';
import MigrationNotice from '../components/MigrationNotice.astro';
import { absoluteUrl } from '../lib/seo';

const target = '/ประเมินราคา/';
---

<BaseLayout
  title="เช็คราคาโน๊ตบุ๊คมือสอง | ย้ายรวมหน้าประเมินราคา"
  description="คำค้นเช็คราคาโน๊ตบุ๊คมือสองถูกรวมเข้าหน้าประเมินราคา เพื่อให้การประเมินเครื่องใช้งานแล้วอยู่ใน owner เดียว"
  canonical={absoluteUrl(target)}
  noindex={true}
>
  <MigrationNotice
    title="เช็คราคาโน๊ตบุ๊คมือสอง ย้ายรวมเข้าหน้าประเมินราคา"
    description="เครื่องมือสองยังใช้ปัจจัยประเมินชุดเดียวกัน ได้แก่ รุ่น สเปก สภาพ แบตเตอรี่ อาการและอุปกรณ์ จึงไม่แยกหน้าเช็คราคามือสองออกจาก owner หลักอีกต่อไป"
    targetHref={target}
    targetLabel="ไปหน้าประเมินราคาโน๊ตบุ๊ค"
  />
</BaseLayout>
