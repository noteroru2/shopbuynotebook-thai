---
import BaseLayout from '../../layouts/BaseLayout.astro';

const brands = [
  ['asus', 'ASUS'], ['acer', 'Acer'], ['lenovo', 'Lenovo'], ['hp', 'HP'],
  ['dell', 'Dell'], ['msi', 'MSI'], ['macbook', 'MacBook'], ['surface', 'Microsoft Surface'],
];
---

<BaseLayout
  title="แบรนด์โน๊ตบุ๊คที่รับประเมิน | ร้านรับซื้อโน๊ตบุ๊ค.com"
  description="ศูนย์รวมหน้ารับประเมินโน๊ตบุ๊คแยกตามแบรนด์ เพื่อให้เลือกแบรนด์และรุ่นได้ตรงก่อนส่งข้อมูลประเมิน"
  noindex={true}
>
  <section class="mx-auto w-full max-w-6xl px-4 py-14 sm:py-20">
    <p class="text-sm font-bold text-emerald-700">Notebook Specialist</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">รับซื้อโน๊ตบุ๊ค แยกตามแบรนด์</h1>
    <p class="mt-5 max-w-3xl text-base leading-8 text-slate-700">
      Brand Hub แยกออกจากรุ่น อาการ และพื้นที่อย่างชัดเจน แต่ละแบรนด์เป็น Parent ของหน้ารุ่นที่เกี่ยวข้องและไม่ใช้หน้าเดียวกันแย่งคำค้นกับ Model Page
    </p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {brands.map(([slug, label]) => (
        <a href={`/แบรนด์/${slug}/`} class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md">
          <h2 class="font-extrabold text-slate-950 group-hover:text-emerald-700">{label}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">ดูข้อมูลที่ควรส่ง ร้านประเมินจากอะไร และไปต่อยังรุ่นที่เกี่ยวข้อง</p>
          <span class="mt-4 inline-flex text-sm font-bold text-emerald-700">ดูแบรนด์ →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
