---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="แบรนด์โน๊ตบุ๊คที่รับประเมิน | ร้านรับซื้อโน๊ตบุ๊ค.com"
  description="ศูนย์รวมหน้ารับประเมินโน๊ตบุ๊คแยกตามแบรนด์ เพื่อให้เลือกแบรนด์และรุ่นได้ตรงก่อนส่งข้อมูลประเมิน"
  noindex={true}
>
  <section class="mx-auto w-full max-w-6xl px-4 py-14 sm:py-20">
    <p class="text-sm font-bold text-emerald-700">Notebook Specialist</p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950 sm:text-5xl">รับซื้อโน๊ตบุ๊ค แยกตามแบรนด์</h1>
    <p class="mt-5 max-w-3xl text-base leading-8 text-slate-700">
      โครงสร้างใหม่นี้จะแยก Brand Hub ออกจากรุ่น อาการ และพื้นที่อย่างชัดเจน เพื่อให้แต่ละหน้ามีหน้าที่เดียวและไม่แย่งคำค้นกันเอง
      ก่อนส่งประเมินควรเตรียมชื่อรุ่น CPU GPU RAM SSD สภาพ แบตเตอรี่ และอุปกรณ์ที่มี
    </p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {['ASUS','Acer','Lenovo','HP','Dell','MSI','MacBook','Microsoft Surface'].map((brand) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="font-extrabold text-slate-950">{brand}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">หน้าแบรนด์จะเปิด index เมื่อผ่าน migration และ content gate เท่านั้น</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
