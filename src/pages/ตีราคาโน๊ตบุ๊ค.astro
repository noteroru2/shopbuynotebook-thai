---
import BaseLayout from '../layouts/BaseLayout.astro';
import MigrationNotice from '../components/MigrationNotice.astro';
import { absoluteUrl } from '../lib/seo';

const target = '/ประเมินราคา/';
---

<BaseLayout
  title="ตีราคาโน๊ตบุ๊ค | ย้ายรวมหน้าประเมินราคา"
  description="วิธีตีราคาโน๊ตบุ๊คถูกรวมเข้าหน้าประเมินราคา เพื่อให้ปัจจัยราคาและขั้นตอนประเมินอยู่ใน owner เดียว"
  canonical={absoluteUrl(target)}
  noindex={true}
>
  <MigrationNotice
    title="ตีราคาโน๊ตบุ๊ค ย้ายรวมเข้าหน้าประเมินราคา"
    description="V2 ไม่แยกคำว่า ตีราคา ออกจาก เช็คราคา และ ประเมินราคา อีกต่อไป เนื้อหาวิธีประเมินถูกย้ายไปรวมกับหน้า owner เพื่อให้ Search Intent ชัดขึ้น"
    targetHref={target}
    targetLabel="ไปหน้าประเมินราคาโน๊ตบุ๊ค"
  />
</BaseLayout>
